# Ключ от Claude API (получить: https://console.anthropic.com/ -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно: код доступа. Если задан, приложение спросит его один раз
# у каждого, кто открыл ссылку — иначе ключом сможет пользоваться любой прохожий.
ACCESS_CODE=

# Необязательно: порт (по умолчанию 3000)
PORT=3000
